[Unit]
Description=EMA Industrial Touchscreen Kiosk Display
After=ema.service graphical.target
Wants=graphical.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/opt/ema/rpi/scripts/kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
