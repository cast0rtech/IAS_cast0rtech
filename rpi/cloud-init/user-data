#cloud-config
# EMA Appliance Cloud-Init Profile for Raspberry Pi OS (Debian 12 Bookworm 64-bit)
# Place in /boot/firmware/user-data (or use with Raspberry Pi Imager Customization)

hostname: ema-gateway
manage_etc_hosts: true

users:
  - name: pi
    gecos: EMA Administrator
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: [sudo, docker]
    lock_passwd: false
    # Default password: raspberry (change in production!)
    passwd: "$6$rounds=4096$7XmK9H/B$tW4R5Jj5P5c6qF6UeI7ZkC0O1rP2sQ3tU4vW5xY6zA7bC8dE9fG0hI1jK2lM3nO4pQ5rS6tU7vW8xY9z0"

package_update: true
package_upgrade: true

packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg
  - chrony
  - ufw
  - git

write_files:
  - path: /etc/modules-load.d/bcm2835_wdt.conf
    content: |
      bcm2835_wdt

  - path: /etc/systemd/system.conf.d/watchdog.conf
    content: |
      [Manager]
      RuntimeWatchdogSec=15s

runcmd:
  - systemctl daemon-reload
  - systemctl enable chrony
  - systemctl restart chrony
  # Install Docker Engine
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  - chmod a+r /etc/apt/keyrings/docker.gpg
  - echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update -y
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  - systemctl enable docker
  - systemctl start docker
  - usermod -aG docker pi
  # Clone and setup EMA Stack
  - mkdir -p /opt/ema
  - git clone https://github.com/cast0rtech/IAS_cast0rtech.git /opt/ema || true
  - chmod +x /opt/ema/rpi/setup.sh
  - cd /opt/ema && ./rpi/setup.sh
